#!/bin/sh
# Maven Wrapper script for Unix/Mac
# Downloads Maven if not present, then runs it.

MAVEN_VERSION="3.9.6"
MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_ZIP_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"
MAVEN_ZIP="/tmp/apache-maven-$MAVEN_VERSION-bin.zip"

if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
  echo "Downloading Apache Maven $MAVEN_VERSION..."
  curl -fsSL "$MAVEN_ZIP_URL" -o "$MAVEN_ZIP"
  mkdir -p "$HOME/.m2/wrapper/dists"
  unzip -q "$MAVEN_ZIP" -d "$HOME/.m2/wrapper/dists"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
